# Cloud Run runtime variables, YAML for `gcloud run deploy --env-vars-file`.
# Copy to .env.runtime (gitignored) and fill with the PRODUCTION values from
# Vercel → Project → Settings → Environment Variables (Production), plus the dashboards noted below.
# Quote every value. Do NOT put development (.env.local) values here: those are Stripe TEST keys.

# --- Supabase
SUPABASE_SERVICE_ROLE_KEY: ""      # Supabase → Project Settings → API

# --- Stripe (LIVE)
STRIPE_SECRET_KEY: "sk_live_..."   # Stripe → Developers → API keys
STRIPE_WEBHOOK_SECRET: "whsec_..." # Stripe → Developers → Webhooks → your live endpoint → Signing secret
STRIPE_PRICE_PRO_MONTHLY: "price_..."
STRIPE_PRICE_PRO_YEARLY: "price_..."
STRIPE_PRICE_SCALE_MONTHLY: "price_..."
STRIPE_PRICE_SCALE_YEARLY: "price_..."

# --- Inngest (Inngest Cloud → your app → Keys)
INNGEST_EVENT_KEY: ""
INNGEST_SIGNING_KEY: ""
INNGEST_SERVE_HOST: "https://elitevaultapp.com"   # the SDK reads this itself; keeps callbacks on the stable domain

# --- AI
AI_PROVIDER: "gemini"
GEMINI_API_KEY: ""                 # Google AI Studio (Vercel's copy is write-only: create/copy again)
GEMINI_MODEL: ""
GEMINI_MODEL_FAST: ""
GEMINI_MODEL_STABLE: ""
GEMINI_API_KEY_JOBS: ""
ANTHROPIC_API_KEY: ""

# --- Capture / library / email
SCREENSHOTONE_ACCESS_KEY: ""
META_AD_LIBRARY_TOKEN: ""
MICROLINK_API_KEY: ""
RESEND_API_KEY: ""
RESEND_FROM: ""
EMAIL_UNSUBSCRIBE_SECRET: ""
ANON_SESSION_SECRET: ""

# --- Owner / ops
ADMIN_EMAILS: ""
INTERNAL_EMAILS: ""
OWNER_NOTIFY_EMAIL: ""
SUPPORT_NOTIFY_EMAIL: ""
POSTHOG_API_KEY: ""
POSTHOG_API_HOST: ""
POSTHOG_PROJECT_ID: ""

# --- Everything else that is set in Vercel Production (feature flags and tuning), e.g.
# AUTO_LOCALE, ANALYZER_*, GEMINI_HEDGE_AFTER_MS, GEMINI_CALL_CAP_MS, SCREENSHOT_*, ENABLE_ANON_PREVIEW,
# ANON_AUDIT_LIMIT_PER_DAY, CHECKOUT_RECOVERY_ENABLED, REPORT_UNLOCK, ANALYZER_REPORT_V2 ... copy them as they are.
